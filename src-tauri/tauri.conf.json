{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maps",
  "version": "0.2.0",
  "identifier": "com.arfium.maps",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://localhost:1426",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maps",
        "width": 1180,
        "height": 820,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "../assets/icon.png"
    ]
  }
}
